/misc              emmc     /dev/block/by-name/misc      flags=display=misc
/bootloader        emmc     /dev/block/bootloader        flags=display=bootloader
/logo              emmc     /dev/block/logo              flags=display=logo
/vbmeta            emmc     /dev/block/vbmeta            flags=display=vbmeta
/vbmeta_system     emmc     /dev/block/vbmeta_system     flags=display=vbmeta_system
/boot              emmc     /dev/block/boot              flags=display=boot
/misc              emmc     /dev/block/misc              flags=display=misc
/param             ext4     /dev/block/param             flags=display=param
/odm_ext           ext4     /dev/block/odm_ext           flags=display=odm_ext
/oem               ext4     /dev/block/oem               flags=display=oem
/metadata          ext4     /dev/block/metadata          flags=display=metadata
/tee               ext4     /dev/block/tee               flags=display=tee
/data              ext4     /dev/block/userdata          flags=display=data
/sdcard            vfat     /dev/block/mmcblk1p1         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk1p2         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk1p3         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk1p4         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk1p5         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk1p6         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk2p1         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk2p2         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk2p3         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk2p4         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk2p5         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk2p6         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk            flags=display=sdcard
/udisk             auto     /dev/block/sd##              flags=display=udisk
# Dynamische Partitionen (nur Slot A vorhanden, super_a)
/system            ext4     /dev/block/mapper/system_a     flags=display=system;backup=1;flashimg=1;ro
/system_ext        ext4     /dev/block/mapper/system_ext_a flags=display=system_ext;backup=1;flashimg=1;ro
/vendor            ext4     /dev/block/mapper/vendor_a     flags=display=vendor;backup=1;flashimg=1;ro
/product           ext4     /dev/block/mapper/product_a    flags=display=product;backup=1;flashimg=1;ro
/odm               ext4     /dev/block/mapper/odm_a        flags=display=odm;backup=1;flashimg=1;ro
# Wichtige physische Partitionen für Backup/Restore
/boot_a            emmc     /dev/block/by-name/boot_a      flags=display=boot_a;backup=1;flashimg=1
/vendor_boot_a     emmc     /dev/block/by-name/vendor_boot_a flags=display=vendor_boot_a;backup=1;flashimg=1
/dtbo_a            emmc     /dev/block/by-name/dtbo_a      flags=display=dtbo_a;backup=1;flashimg=1
/super             emmc     /dev/block/by-name/super       flags=display=super;backup=1
