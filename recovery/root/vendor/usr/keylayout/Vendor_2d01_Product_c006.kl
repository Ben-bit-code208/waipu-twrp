#
# Generic key layout file for full alphabetic US English PC style external keyboards.
#
# This file is intentionally very generic and is intended to support a broad rang of keyboards.
# Do not edit the generic key layout to support a specific keyboard; instead, create
# a new key layout file with the required keyboard configuration.
#

key 116   POWER
key usage 0x0c0037 1
key usage 0x0c0038 2
key usage 0x0c0039 3
key usage 0x0c003a 4
key usage 0x0c003b 5
key usage 0x0c003c 6
key usage 0x0c003d 7
key usage 0x0c003e 8
key usage 0x0c003f 9
key usage 0x0c0007 GUIDE 
key usage 0x0c000f 0
key 139   INFO
key 113   VOLUME_MUTE
key 217   ASSIST
key 384   NES_SHORTCUT_09
key 115   VOLUME_UP
key 103   DPAD_UP
key 402   CHANNEL_UP
key 105   DPAD_LEFT
key 353   DPAD_CENTER
key 106   DPAD_RIGHT
key 114   VOLUME_DOWN
key 108   DPAD_DOWN
key 403   CHANNEL_DOWN
key 158   BACK
key 172   HOME
key 362   TV
key 163   MEDIA_REWIND
key 208   MEDIA_FAST_FORWARD
key 168   MEDIA_PREVIOUS
key 164   MEDIA_PLAY_PAUSE
key 167   MEDIA_RECORD
key usage 0x0c00d1  STEM_1 
key usage 0x0c00d2  NES_SHORTCUT_02
key usage 0x0c00d3  NES_SHORTCUT_04
